# SMTP para envio de confirmação de cadastro
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-usuario-smtp
SMTP_PASS=sua-senha-smtp
SMTP_FROM=Pet Joyful <no-reply@example.com>

# URL pública da API, sem barra final
API_BASE_URL=http://localhost:5000
# Opcional: substitui API_BASE_URL nos links enviados
# EMAIL_VERIFICATION_URL=https://api.example.com
